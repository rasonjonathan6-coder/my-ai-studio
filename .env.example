# My AI Studio - example environment. Copy to .env and fill in real values.
# NEVER commit a filled-in .env file.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# PostgreSQL / Supabase connection string, e.g.
# postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# OpenRouter (server-side only). Never expose to the frontend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_REFERER=https://my-ai-studio.example
OPENROUTER_TITLE=My AI Studio

# Additional AI providers used by the agent router. All are optional; the agent
# works with whichever are configured. Keys live only in this server-side file
# and are never sent to the browser or embedded in any build.
# AUTO mode tries AI_PROVIDER_ORDER and fails over on temporary limits only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT_MS=120000

GROQ_API_KEY=
# Use qwen here, not a gpt-oss model. The agent drives its tools through a text
# JSON protocol, and Groq's gpt-oss models ship a built-in repo_browser tool that
# intercepts tool-shaped prompts and rejects the turn with HTTP 400
# tool_use_failed, which no tool_choice setting suppresses.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=120000

AI_DEFAULT_PROVIDER=auto
# Priority order for AUTO. Every id is optional: one whose key is absent is
# simply reported NOT CONFIGURED and skipped. Valid ids:
#   openrouter, gemini, groq, cerebras, mistral, cloudflare, nvidia,
#   huggingface, chutes, sambanova, ollama, vllm
# AI_PROVIDER_ORDER is the older name and is still honoured as a fallback.
AI_PROVIDER_PRIORITY=openrouter,gemini,groq,cerebras,mistral,cloudflare,nvidia,huggingface,chutes,sambanova
AI_PROVIDER_ORDER=openrouter,gemini,groq
# First cooldown after a limit response. Repeated limits escalate automatically
# through 1m and 5m up to AI_PROVIDER_COOLDOWN_MAX_MS, and a provider's own
# Retry-After always wins. A success resets the ladder.
AI_PROVIDER_COOLDOWN_MS=30000
AI_PROVIDER_COOLDOWN_MAX_MS=900000

# --- Additional independent providers (each calls its own official API) ---
# Leave a key empty to keep that provider out of rotation. Nothing is shared:
# a provider's failure never affects another's.

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TIMEOUT_MS=120000

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=120000

# Cloudflare needs BOTH an API token and the account id: the account id is part
# of the OpenAI-compatible path, so a token alone is not a usable endpoint.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
CLOUDFLARE_TIMEOUT_MS=120000

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=120000

# Hugging Face router. Free credit is limited, so its priority is last by default.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_MS=120000

CHUTES_API_KEY=
CHUTES_MODEL=deepseek-ai/DeepSeek-V3-0324
CHUTES_BASE_URL=https://llm.chutes.ai/v1
CHUTES_TIMEOUT_MS=120000

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_TIMEOUT_MS=120000

# --- Local runtimes (no API key) ---
# Set the URL and the model to enable one. The URL must include the
# OpenAI-compatible suffix, e.g. http://localhost:11434/v1 for Ollama.
# Availability is reported from a real probe, never assumed from the URL alone.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=120000
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_TIMEOUT_MS=120000

# Auth
JWT_SECRET=
JWT_TTL_SECONDS=604800
SESSION_COOKIE_NAME=mas_session
# lax (same site), strict, or none for a cross-site frontend (needs HTTPS)
SESSION_COOKIE_SAMESITE=lax

# Storage
WORKSPACE_PATH=./workspace-data/projects
STORAGE_PATH=./workspace-data/storage

# Agent + resource limits
MAX_FIX_ATTEMPTS=5
AGENT_TIMEOUT_MS=1200000
COMMAND_TIMEOUT_MS=600000
BUILD_TIMEOUT_MS=1800000
MAX_OUTPUT_BYTES=524288
MAX_FILE_BYTES=2097152
MAX_PROJECT_BYTES=536870912
MAX_CONCURRENT_JOBS=3
MAX_REQUEST_BODY=4mb

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
TERMINAL_RATE_LIMIT_MAX=30
AGENT_RATE_LIMIT_MAX=15
BUILD_RATE_LIMIT_MAX=10

# Sandbox (Docker). SANDBOX_ENABLED=false falls back to a guarded host process.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=my-ai-studio-sandbox:latest
# Passed as a build arg to sandbox/Dockerfile. 1 installs JDK 17 so Gradle can
# run; the image has no `java` at all otherwise and every build fails.
INSTALL_ANDROID_TOOLCHAIN=1
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_NETWORK_DISABLED=false

# Toolchains mounted into the sandbox from the host. The Gradle cache must be
# writable by uid 1000, which is the user the sandbox runs as:
#   sudo mkdir -p /opt/gradle-cache && sudo chown 1000:1000 /opt/gradle-cache
# The backend falls back to an ephemeral cache if it is not writable.
# SANDBOX_EXTRA_MOUNTS=/opt/android-sdk:/opt/android-sdk:ro,/opt/gradle-cache:/opt/gradle-cache
SANDBOX_EXTRA_MOUNTS=

# Android toolchain (leave empty to let the backend probe PATH)
ANDROID_HOME=
JAVA_HOME=
# Docker Compose only: host path to an Android SDK to mount read-only at
# /opt/android-sdk inside the backend. With it, APK inspection uses the real
# aapt2/apksigner; without it the built-in AXML parser still reports accurate
# package, version, SDK level and component data from the APK itself.
ANDROID_SDK_DIR=

# CORS: comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- GitHub Actions integration ---------------------------------------------
# With a credential and a repository set, the Build Center can publish a project
# to the repository and dispatch the android-build workflow, then track the run
# and offer the real APK artifact for download. Without them the UI answers
# GITHUB_NOT_CONFIGURED; it never claims a run happened. Credentials stay
# server-side and are never sent to the browser, written to a log, or exported.
#
# Option A — a token (simplest). Needs "Actions: write" (dispatch, cancel) and
# "Contents: write" (publish the project) on the repository below:
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=owner/repository
#
# Option B — a GitHub App (preferred in production; short-lived installation
# tokens, no long-lived secret). Set all three instead of GITHUB_TOKEN:
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_OWNER=owner
#
# Only this workflow can ever be dispatched, regardless of request input:
# GITHUB_WORKFLOW=android-build.yml
# Optional overrides:
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_TIMEOUT_MS=30000
# GITHUB_WORKFLOW_REF=
# GITHUB_BUILD_TIMEOUT_MS=1200000
# GITHUB_BUILD_POLL_MS=5000
