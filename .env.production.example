# My AI Studio - production environment template.
# Copy to .env on the server and fill in real values. NEVER commit this file.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Required. The backend refuses to start without a working database.
# Supabase example (note sslmode=require for managed Postgres):
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Required in production. Startup fails if this is missing or left as the
# development default.
JWT_SECRET=
# Encrypts the GitHub credential stored through the admin API. Separate from
# JWT_SECRET so rotating session keys does not lock the credential out; without
# it the credential falls back to JWT_SECRET and cannot be read after a restart
# if that is unset. Required for a durable credential. Generate with:
# openssl rand -hex 32
MY_AI_STUDIO_CREDENTIAL_KEY=
# Promotes this existing account to administrator at startup. Needed whenever the
# database already has users and none is an admin, because the credential API is
# admin-only.
MY_AI_STUDIO_ADMIN_EMAIL=
JWT_TTL_SECONDS=604800
SESSION_COOKIE_NAME=mas_session
# lax (same site), strict, or none. Use `none` when the frontend is on a
# different site from the API (the normal Cloudflare Pages + VM setup); it
# forces Secure and therefore requires HTTPS. Use `lax` if both are same-site.
SESSION_COOKIE_SAMESITE=none

# OpenRouter. Server-side only; the browser never receives this value.
# Without it the agent reports `not_configured` instead of failing startup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_REFERER=https://your-frontend-domain.example
OPENROUTER_TITLE=My AI Studio

# Additional providers the router can fail over to. All optional: an empty key
# leaves that provider out of rotation and it reports NOT_CONFIGURED, which is
# not an error. Each one calls its own official API; no key is shared.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI is the one provider that needs an account id as well as
# a token: the account id is part of the OpenAI-compatible path, so a token on
# its own has no endpoint to call. The token also needs the "Workers AI" account
# permission, otherwise the API answers 401 Authentication error.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Absolute paths on the server. Both must be writable by the runtime user
# (uid 1000 when using the shipped images).
WORKSPACE_PATH=/data/workspaces
STORAGE_PATH=/data/storage

# Resource limits. Tune to the VM size; Oracle Always Free is 1 OCPU / 1 GB.
MAX_FIX_ATTEMPTS=5
AGENT_TIMEOUT_MS=1200000
COMMAND_TIMEOUT_MS=600000
BUILD_TIMEOUT_MS=1800000
MAX_OUTPUT_BYTES=524288
MAX_FILE_BYTES=2097152
MAX_PROJECT_BYTES=536870912
MAX_CONCURRENT_JOBS=3
MAX_REQUEST_BODY=4mb

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
TERMINAL_RATE_LIMIT_MAX=30
AGENT_RATE_LIMIT_MAX=15
BUILD_RATE_LIMIT_MAX=10

# Sandbox. Set true in production: agent commands then run in a throwaway
# container instead of on the host process.
SANDBOX_ENABLED=true
SANDBOX_IMAGE=my-ai-studio-sandbox:latest
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_NETWORK_DISABLED=false
SANDBOX_EXTRA_MOUNTS=

# Android toolchain paths inside the container/host.
ANDROID_HOME=
JAVA_HOME=

# The exact frontend origin(s). Do not use '*' in production: the API is
# cookie-authenticated.
CORS_ORIGINS=https://your-frontend-domain.example
LOG_LEVEL=info

# --- GitHub Actions integration ---------------------------------------------
# Enables publishing a project to the repository, dispatching
# .github/workflows/android-build.yml, tracking the run and downloading the real
# APK artifact. Without this the Build Center answers GITHUB_NOT_CONFIGURED.
#
# Option A — store it in My AI Studio. Sign in as an administrator and use
# Settings → GitHub credential. It is encrypted in the database and survives a
# restart. This is the recommended and durable option.
#
# Option B — deployment variable. Deliberately NOT GITHUB_TOKEN: a hosting
# runtime may inject its own GITHUB_TOKEN into every process, which would
# override --env-file and shadow this value. A credential stored in Settings
# takes precedence over this variable.
# MY_AI_STUDIO_GITHUB_TOKEN=
# MY_AI_STUDIO_GITHUB_REPO=owner/repository
# GITHUB_REPO=owner/repository
# Option C — GitHub App (preferred). Set these instead of a token.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_INSTALLATION_ID=
# GITHUB_OWNER=
# Only this workflow can ever be dispatched:
GITHUB_WORKFLOW=android-build.yml
# GITHUB_WORKFLOW_REF=
# GITHUB_BUILD_TIMEOUT_MS=1200000
# GITHUB_BUILD_POLL_MS=5000
