# Ephemeral sandbox image for agent-run shell commands.
# Commands are executed with the project directory bind-mounted at /workspace,
# as a non-root user, with resource limits applied by docker-compose.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git curl ca-certificates unzip zip \
      openjdk-17-jdk-headless \
      python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /bin/bash sandbox \
 && mkdir -p /workspace /home/sandbox/.gradle \
 && chown -R sandbox:sandbox /workspace /home/sandbox

USER sandbox
WORKDIR /workspace
ENV HOME=/home/sandbox \
    GRADLE_USER_HOME=/home/sandbox/.gradle \
    NODE_ENV=development

# Idle by default; the backend spawns `docker run` per command.
CMD ["sleep", "infinity"]
