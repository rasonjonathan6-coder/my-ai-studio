# My AI Studio - production stack as a systemd service.
#
# Install (on the host, as root):
#
#   sudo install -m 0644 deploy/my-ai-studio.service /etc/systemd/system/
#   sudo install -m 0600 /dev/null /etc/my-ai-studio/secrets.env
#   sudo editor /etc/my-ai-studio/secrets.env     # fill it in, see below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now my-ai-studio
#
# Why this exists
# ---------------
# scripts/deploy-production.sh reads configuration from the process environment
# first and only falls back to .env, and docker-compose.prod.yml forwards the
# secrets the backend consumes from the host environment. So secrets can live in
# /etc/my-ai-studio/secrets.env (root-owned, 0600, outside the checkout) instead
# of a plaintext .env inside the repository working tree. Nothing in the checkout
# then holds a secret, and `git status` stays clean even after a deploy.
#
# Alternative, if your provider has a secret store with an agent or an API
# (AWS Secrets Manager, GCP Secret Manager, Vault): drop EnvironmentFile= and
# have the provider's mechanism export the same variables into this unit's
# environment. Nothing else changes.
#
# Required contents of /etc/my-ai-studio/secrets.env - see .env.production.example
# for the full list and the notes on each value:
#
#   POSTGRES_USER=myaistudio
#   POSTGRES_DB=myaistudio
#   POSTGRES_PASSWORD=<openssl rand -hex 32>
#   JWT_SECRET=<openssl rand -hex 32>
#   MY_AI_STUDIO_CREDENTIAL_KEY=<openssl rand -hex 32, different from JWT_SECRET>
#   OPENROUTER_API_KEY=<your key>
#   MY_AI_STUDIO_DOMAIN=studio.example.com
#   ACME_EMAIL=you@example.com
#   DATA_ROOT=/srv/my-ai-studio
#   CADDYFILE=deploy/Caddyfile            # or deploy/Caddyfile.public behind an edge
#   WEB_HTTP_PORT=80
#   WEB_HTTPS_PORT=443
#
# Do not set DOCKER_GID here: deploy-production.sh derives it from the socket and
# overrides whatever the environment holds.

[Unit]
Description=My AI Studio production stack
Documentation=file:///opt/my-ai-studio/DEPLOYMENT.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/my-ai-studio

# Secrets stay out of the checkout. 0600, root-owned, never committed.
EnvironmentFile=/etc/my-ai-studio/secrets.env

# deploy-production.sh brings the stack up and verifies it is actually serving
# before exiting 0, so a failed deploy fails the unit rather than silently
# leaving a broken stack behind.
ExecStart=/usr/bin/env bash /opt/my-ai-studio/scripts/deploy-production.sh

# Stopping the unit stops the containers but keeps volumes, so data and issued
# certificates survive.
ExecStop=/usr/bin/docker compose -p masprod -f /opt/my-ai-studio/docker-compose.prod.yml down

Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
